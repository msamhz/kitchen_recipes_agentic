# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres connection string — get from console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://...

# Backend API URL — used by the React frontend (baked in at Vite build time)
# Local: http://localhost:8000
# Production: your Lambda API Gateway URL or Railway URL
VITE_API_URL=https://...

# Set to 1 to run without a real Anthropic API key (returns canned responses)
MOCK_CLAUDE=0
