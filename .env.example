# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# Variable reference
# ──────────────────
# [RAILWAY]  Set these in Railway → your project → Variables.
# [LOCAL]    Used only during local development (not needed on Railway).
# [VERCEL]   Set these in Vercel → your project → Settings → Environment Variables.
#            These are VITE_ prefixed and are baked into the frontend bundle at build time.

# ── Backend secrets ──────────────────────────────────────────────────────────

# [RAILWAY] [LOCAL]
# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# [RAILWAY] [LOCAL]
# Neon Postgres connection string — get from console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://...

# ── Railway-injected (do NOT set manually) ───────────────────────────────────

# [RAILWAY] — Railway sets this automatically to the container's assigned port.
# Your CMD must honour it: uvicorn ... --port ${PORT}
# PORT=8000   <-- Railway sets this; do not hard-code in app code

# ── Frontend build vars (Vercel only) ────────────────────────────────────────

# [VERCEL]
# Public URL of the backend.  During local dev, set to http://localhost:8000.
# After Railway is deployed, update to https://<your-service>.up.railway.app
VITE_API_URL=http://localhost:8000

# [VERCEL] [LOCAL]
# Basic Auth credentials used by the Vercel Edge middleware (frontend/middleware.js).
# These are NOT sent to the backend — they protect the Vercel URL itself.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme
